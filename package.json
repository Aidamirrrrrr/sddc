{
  "name": "spec-agent",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "bin": {
    "spec-agent": "./src/main.ts"
  },
  "scripts": {
    "start": "bun run src/main.ts",
    "format": "biome format --write .",
    "lint": "biome lint .",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "check": "biome check . && bun run typecheck && bun test",
    "ci": "biome ci . && bun run typecheck && bun test"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "^3.0.35",
    "@clack/prompts": "^1.7.0",
    "ai": "^7.0.77",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.10",
    "@types/bun": "^1.3.0",
    "@types/json-schema": "^7.0.15",
    "typescript": "^5.9.2"
  }
}
